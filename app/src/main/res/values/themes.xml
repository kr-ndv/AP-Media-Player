<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OpenMediaPlayer" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#B69ADB</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#111217</item>
        <item name="android:statusBarColor">#111217</item>
        <item name="android:navigationBarColor">#111217</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.OpenMediaPlayer.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#111217</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/av_music_player_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.OpenMediaPlayer</item>
    </style>
</resources>
